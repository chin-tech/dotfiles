#!/usr/bin/env bash

declare POST_TITLE
declare POST_DATE
declare POST_TYPE
declare POST_ASSET_PATH
TEMPLATE_DIR="$HOME/notes/.templates"
VALID_POST_TYPES=("htb" "vulnlab" "wargame" "blog" "other")

post_type=${1,,}
post_title=${2}
template="$TEMPLATE_DIR/blog-template.md"
blog_dir="$HOME/notes/chin-tech.github.io/src/content/blog/"


usage() {
   echo "new_post <post_style: [${VALID_POST_TYPES[@]}] > <post_title> "
   exit 1
}

[[ -z $post_type ]] || [[ -z $post_title ]] && usage

for p in "${VALID_POST_TYPES[@]}"; do
   if [[ $post_type =~ $p ]]; then
      POST_TYPE=$p
   fi
done

if [[ -z $POST_TYPE ]]; then
   echo '[!] Invalid Post Type'
   echo "Valid Styles: ${VALID_POST_TYPES[@]}"
   exit 1
fi

case "$POST_TYPE" in
   "htb"    ) out_path="$blog_dir/HackTheBox"     ;;
   "vulnlab") out_path="$blog_dir/Vulnlab" ;;
   "wargame") out_path="$blog_dir/Wargames";;
   *        ) out_path="$blog_dir/General" ;;
esac



export POST_TITLE="${post_title// /-}"
export POST_DATE=$(date '+%Y-%m-%d')
export POST_ASSET_PATH="${POST_TYPE}-${POST_TITLE@L}"
export POST_TYPE

file_name="${post_title// /-}_$POST_DATE"
out_path=$blog_dir
out_file="${out_path}/${file_name,,}.md"

envsubst '$POST_TITLE $POST_DATE $POST_ASSET_PATH $POST_TYPE' < "$template" > "$out_file"
nvim "${out_file}"
