# alias i3statuscfg="nvim ~/.config/i3status-rust/config.toml"
function ecfg() {
    local target="$1"
    local file=""
    local reload_cmd=""
    local dirchanged=false
    local mtime_before
    local mtime_after
    case "$target" in
        v*)
            pushd "$HOME/.config/nvim" 2>/dev/null
            file="$HOME/.config/nvim/init.lua"
            dirchanged=true
            ;;
        b*)
            file="$HOME/.bashrc"
            reload_cmd="source $file"
            ;;
        a*)
            file="$HOME/.bash_aliases"
            reload_cmd="source $file"
            ;;
        g*)
            file="$HOME/.config/ghostty/config"
            ;;
        t*)
            file="$HOME/.config/tmux/tmux.conf"
            ;;
        p*)
            file="$HOME/.config/polybar/config.ini"
            ;;
        i3*)
            file="$HOME/.config/i3/config"
            ;;
        *)
            echo "Usage: ecfg [v(im) | b(ash) | a(lias) | g(hostty) | t(mux) | i3 | p(olybar)]"
            return 1
            ;;
    esac
    if [[ ! -f "$file" ]]; then
        echo "Error: $file does not exist."
        return 1
    fi

    mtime_before=$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file")

    $EDITOR "$file"
    if $dirchanged; then
       popd > /dev/null
    fi
    mtime_after=$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file")

    if [[ "$mtime_before" != "$mtime_after" ]]; then
        chezmoi re-add "$file"
        if [[ -n "$reload_cmd" ]]; then
            eval "$reload_cmd"
        fi
    fi
}
